# Copy to .env and fill in.

# --- LLM ---
# Leave blank to run fully offline against the deterministic fake provider.
# Set a real key (sk-ant-...) to switch to Claude. Blank is the default so a
# fresh clone works with no account and no spend.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
# Titles only. Five titles is a ~2k-token call, so the strongest model costs
# cents here — the script is the expensive stage and stays on LLM_MODEL.
TITLES_MODEL=claude-fable-5

# Let the script stage search the web before writing, so it draws on what Neil
# deGrasse Tyson has actually said on the topic and on current figures rather
# than on recalled knowledge. Adds $10 per 1,000 searches and a minute or two
# per script. Set false to write offline from the model's own knowledge.
SCRIPT_WEB_SEARCH=true
WEB_SEARCH_MAX_USES=8

# Hard ceiling on what one run may spend, in US dollars, across every stage.
# A stage that could cost more than what is left never starts, and the run
# fails with a message saying what it would have cost. A typical 8-minute
# script with search on runs well under $0.50, so this is a runaway guard
# rather than a normal constraint. Very long scripts are refused up front when
# their worst case will not fit — raise this to allow them.
RUN_BUDGET_USD=3.00

# --- TTS ---
# Which provider the voice registry resolves to.
#   fake  - silent WAVs; whole pipeline runs with no key and no cost
#   local - Chatterbox on your own machine; free, clones a voice from a sample
#   http  - a paid hosted vendor
TTS_PROVIDER=fake
TTS_API_KEY=
TTS_BASE_URL=

# Where the self-hosted TTS server listens (TTS_PROVIDER=local).
# From inside Docker, host.docker.internal reaches the server on your laptop.
# Running the backend directly on Windows instead? Use http://localhost:8004.
# Setup: docs/local-tts.md
TTS_LOCAL_URL=http://host.docker.internal:8004

# Voice character. These are the defaults in config.py, repeated here because
# they are the knobs worth reaching for; uncomment to override for one machine.
# TTS_LOCAL_TEMPERATURE=0.6     # lower = steadier, more repeatable
# TTS_LOCAL_EXAGGERATION=0.85   # higher = more theatrical
# TTS_LOCAL_CFG_WEIGHT=0.5      # higher = closer to the reference clip
# TTS_LOCAL_SPEED_FACTOR=1.0    # 1.0 = untouched; anything else resamples

# --- Storage (MinIO locally, S3/R2 in prod) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=scriptcast

# --- Auth (single user) ---
# Any request must send: Authorization: Bearer <APP_TOKEN>
APP_TOKEN=dev-local-token

# --- Infra ---
DATABASE_URL=postgresql+asyncpg://scriptcast:scriptcast@localhost:5432/scriptcast
SYNC_DATABASE_URL=postgresql+psycopg://scriptcast:scriptcast@localhost:5432/scriptcast
REDIS_URL=redis://localhost:6379/0

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3006

# Host a browser uses to fetch artifacts (presigned URLs are signed against it).
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# Host port for the web container. Change if 3000 is taken on your machine.
WEB_PORT=3000
